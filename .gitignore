# ==============================================================================
# Unity .gitignore file
# Standard industry gitignore for Unity projects
# ==============================================================================

# Autogenerated and cache directories (Wajib di-ignore karena dibuat otomatis oleh Unity)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Folder kerja sementara / scratch
/scratch/

# Visual Studio / Visual Studio Code / Rider IDE cache
.vs/
.idea/
.vscode/
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity generated solution and project files (Dibuat otomatis oleh Unity Editor)
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.workspace

# Unity generated meta files for temporary files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini

# Crash reports
sysinfo.txt
*.stackdump

# Build output binaries
*.apk
*.aab
*.unitypackage
*.app
